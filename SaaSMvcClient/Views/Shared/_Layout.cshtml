<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetim Paneli</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SaaSMvcClient.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Arka planı hafif gri yaptık, böylece beyaz kartlar (ürünler) daha şık duracak -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4 py-3">
            <div class="container-fluid">
                <!-- Sol Üstteki Logo / Marka Adı -->
                <a class="navbar-brand fw-bold text-primary fs-4" asp-area="" asp-controller="Products" asp-action="Index">🚀 SaaS Panel</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Sol Taraftaki Ana Menü Butonları -->
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-area="" asp-controller="Products" asp-action="Index">🛍️ Mağaza Vitrini</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-area="" asp-controller="Products" asp-action="Create">➕ Ürün Ekle</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-area="" asp-controller="Orders" asp-action="Index">📦 Siparişlerim</a>
                        </li>
                    </ul>

                    <!-- Sağ Taraftaki Çıkış Butonu -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-outline-danger fw-bold px-4" asp-area="" asp-controller="Auth" asp-action="Login">🚪 Çıkış Yap</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container text-center fw-medium">
            &copy; 2026 - SaaS Yönetim Paneli - Tüm Hakları Saklıdır.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>