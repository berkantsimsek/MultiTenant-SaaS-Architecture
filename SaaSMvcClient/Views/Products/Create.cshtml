@model SaaSMvcClient.Models.ProductViewModel
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="container mt-4">
    <h2>Mağazanıza Yeni Ürün Ekle</h2>
    <p class="text-muted">Buradan eklediğiniz ürünler sadece sizin firmanıza ait olacaktır.</p>
    <hr />

    <!-- Başarı ve Hata Mesajları -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ürün Adı</label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Kulaklık" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Fiyat (₺)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Örn: 1500" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Ürünü Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>